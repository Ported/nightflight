# The boom is the kick's other pole: the pitch starts eight times the note
# and takes 50 ms to land, the punch starts near 370 Hz, and the body rings
# the better part of a second. No click, no knock — felt, not located.
params boom  sweep=8 pitch_decay=0.05 punch=10 punch_decay=0.006 decay=0.7 hold=0.08 click=0.1 knock=0 drive=2
