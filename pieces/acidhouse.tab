5  .   B5  .   .   G5  .   .   D5  . | B4  .   .   E5  .   .   G5  .   B5  .   .   G5  .   .   E5  .

# The filter. Shut at 17 when the acid arrives, open by 25, shut again for the
# breakdown, and climbing all through the build so the drop is the moment it
# arrives rather than a new sound.
macro open curve=16:0,24:0.85,32:0.9,33:0.25,40:0.2,48:1,56:1,62:0.4,64:0.1
  acid bass_cutoff 65 800 2
  acid bass_env_amount 2 5.5
  acid send 0 0.3

# The stabs lose their bite in the breakdown and get it back at the drop.
macro bite curve=24:0,32:1,33:0.15,40:0.15,48:1,58:1,61:0.3,63:0.3,64:1
  # A macro mapping `level` sets the lane's level outright — the `gain=` on
  # the lane line is not a ceiling it works under, it is a value it replaces.
  stab1 strings_cutoff 900 3400 1.6
  stab2 strings_cutoff 850 3200 1.6
  stab3 strings_cutoff 800 3000 1.6
  stab1 level 0 0.91
  stab2 level 0 0.812
  stab3 level 0 0.763

# The pad: barely there under the groove, the whole floor in the breakdown.
# This is the one that makes the breakdown feel like somewhere rather than
# like an absence.
macro hold curve=4:0,8:0.3,24:0.35,32:0.45,34:1,40:1,44:0.4,48:0.45,56:0.5,62:0.8,64:0.2
  pad1 level 0 1.54
  pad2 level 0 1.33
  pad1 strings_cutoff 500 2000
  pad2 strings_cutoff 450 1800

# The lead is sixteenth-fast and six notes a bar, so it cannot just run for
# twenty-four bars — it needs somewhere to arrive. Index is the brightness of
# the FM pair, so this brightens as it rises rather than only getting louder,
# and goes dry as the mix fills up.
macro tune curve=33:0,35:0.45,40:0.9,41:0,45:0.3,48:1,56:1,60:0.85,62:0.3,64:0
  lead level 0 0.42
  lead glass_index 1.1 2.4
  lead send 0.55 0.18

# The breakdown's stabs need a long tail to read as a pad rather than as
# chords that stopped. Length is not a macro target, so this is reverb.
macro wash curve=32:0,34:1,40:1,44:0,62:0,63:1,64:1
  stab1 send 0.3 0.9
  stab2 send 0.3 0.9
  stab3 send 0.35 0.95

params acid  cutoff=105 env_amount=7 env_decay=0.06 resonance=0.82 sub=0.3 drive=1.3 decay=0.3 release=0.03
params stab1 copies=5 detune=20 depth=6 cutoff=3200 attack=0.004 release=0.09 phaser=0.25
params stab2 copies=5 detune=22 depth=6 cutoff=3000 attack=0.004 release=0.09 phaser=0.3
params stab3 copies=5 detune=24 depth=7 cutoff=2800 attack=0.004 release=0.1 phaser=0.35
params pad1  copies=5 detune=14 depth=11 cutoff=1400 breathe=0.4 breathe_rate=0.05 attack=1.4 release=2.6 phaser=0.6 phaser_rate=0.06
params pad2  copies=5 detune=17 depth=12 cutoff=1200 breathe=0.4 breathe_rate=0.04 attack=1.8 release=2.8 phaser=0.65 phaser_rate=0.05
params lead  ratio=2 index=1.6 index_decay=0.04 decay=0.2 release=0.07 strike=0.7 detune=9
params clap  tone=2000 decay=0.13 noise=1 release=0.03
params hat   tone=9000 decay=0.035 noise=0.85
params ohat  tone=7200 decay=0.19 noise=0.8
params shake tone=12000 decay=0.022 noise=1
params kick  sweep=4.5 pitch_decay=0.028 punch=7 decay=0.3 hold=0.03 click=0.35 knock=0.35 drive=3.2
params sub   cutoff=90 env_amount=2 env_decay=0.12 resonance=0.3 sub=0.8 drive=2 decay=0.8 release=0.1
