# A pluck is FM with the brightness gone before the note is: a high index that
# melts in a tenth of a second, over an amplitude that lasts barely longer.
params pluck ratio=2 index=5.5 index_decay=0.07 decay=0.22 release=0.08 strike=0.35 detune=8

# Acid: the filter's floor low, the envelope throwing it wide open, and enough
# resonance to whistle at the corner. Short env_decay is what makes it bite.
params acid  cutoff=110 env_amount=11 env_decay=0.055 resonance=0.93 sub=0.25 drive=4.5 decay=0.3 release=0.03

# The house organ stab: a wide ensemble cut off almost at once. All the work is
# in the attack and the release; there is no sustain to speak of.
params stab1 copies=5 detune=20 depth=6 cutoff=3200 attack=0.004 release=0.09 phaser=0.25
params stab2 copies=5 detune=22 depth=6 cutoff=3000 attack=0.004 release=0.09 phaser=0.3
params stab3 copies=5 detune=24 depth=7 cutoff=2800 attack=0.004 release=0.1 phaser=0.35

# The layer pair: a bell bright enough to be heard over the saws, and saws dark
# enough not to fight it. Same notes, an octave apart.
params bell  ratio=4 index=3 index_decay=0.3 decay=1.4 release=0.5 strike=0.3 detune=5
params under copies=5 detune=16 depth=9 cutoff=1500 attack=0.01 release=0.4 phaser=0.5 phaser_rate=0.1

# The clap experiment: the hat is a bandpass on noise and its tone will not go
# below 2 kHz, so this is all top and no body. It reads as a rimshot at best.
params clap  tone=2000 decay=0.13 noise=1 release=0.03
params hat   tone=9000 decay=0.035 noise=0.85
params kick  sweep=4.5 pitch_decay=0.028 punch=7 decay=0.3 hold=0.03 click=0.35 knock=0.35 drive=3.2
params sub   cutoff=90 env_amount=2 env_decay=0.12 resonance=0.3 sub=0.8 drive=2 decay=0.8 release=0.1
