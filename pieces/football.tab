# A music box rather than a bell: a high ratio for the metallic strike, the
# brightness gone almost at once, and a long ring under it.
params bell     ratio=3.5 index=1.6 index_decay=0.12 decay=2.4 release=1.8 strike=0.1 detune=4 wow_depth=4 wow_rate=0.3
params bell_low ratio=2 index=1.1 index_decay=0.2 decay=3.2 release=2.4 strike=0.06 detune=5

# Warm and slow in: watercolour, not synth.
params pad      cutoff=1200 detune=5 depth=9 attack=0.7 release=2.2 breathe=0.45 breathe_rate=0.08 phaser=0.4
params pad_high cutoff=1400 detune=6 depth=10 attack=0.9 release=2.2 breathe=0.5 breathe_rate=0.07 phaser=0.45

# Felt, not heard: the heartbeat under the asking.
params heart    sweep=2 pitch_decay=0.02 punch=4 decay=0.2 hold=0.005 click=0.2 knock=0.45 drive=1.6
params ground   cutoff=180 env_amount=3 resonance=0.4 sub=0.5 drive=1.5 decay=0.5 release=0.2
